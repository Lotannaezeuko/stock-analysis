# Copy to .env and fill in. .env is git-ignored.

# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# PostgreSQL connection used by the pipeline and the Streamlit app
DATABASE_URL=postgresql://user:password@localhost:5432/stocks

# Optional: a separate, disposable database for the integration tests (name must end in _test)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/stock_analysis_test
